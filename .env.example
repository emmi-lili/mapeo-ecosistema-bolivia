# Copia a .env.local y completa los valores.

# Opcional: guardar leads en Supabase (false = solo descarga)
EBOOK_STORE_LEADS=false

# Secreto para firmar enlaces de descarga (mín. 16 caracteres)
EBOOK_DOWNLOAD_SECRET=cambia-esto-por-un-secreto-largo

# Solo si EBOOK_STORE_LEADS=true
# SUPABASE_URL=
